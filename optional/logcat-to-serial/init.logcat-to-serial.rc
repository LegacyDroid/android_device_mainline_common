service seriallogging /system/bin/logcat -b all -v threadtime -f /dev/${ro.vendor.seriallogging} *:V
    class main
    user logd
    group root logd
    seclabel u:r:logpersist:s0
    oneshot
    disabled

on early-init && property:ro.boot.seriallogging=*
    setprop ro.vendor.seriallogging ${ro.boot.seriallogging}

on early-boot && property:ro.vendor.seriallogging=*
    chown system logd /dev/${ro.vendor.seriallogging}
    chmod 0660 /dev/${ro.vendor.seriallogging}
    start seriallogging
